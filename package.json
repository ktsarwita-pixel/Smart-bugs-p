{
  "name": "sulfur-miners-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Sulfur Miners v2 \u2014 a Minecraft-style voxel mining game with a robot miner companion.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:physics && npm run test:ui && npm run test:e2e",
    "test:unit": "esbuild scripts/smoke-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs",
    "test:ui": "esbuild scripts/ui-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/uitest.mjs --log-level=warning --external:jsdom && node node_modules/.cache/uitest.mjs",
    "test:e2e": "esbuild scripts/integration-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/e2e.mjs --log-level=warning --external:jsdom && node node_modules/.cache/e2e.mjs",
    "verify": "npm run test && npm run build",
    "test:physics": "esbuild scripts/physics-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/phys.mjs --log-level=warning --external:jsdom && node node_modules/.cache/phys.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/three": "^0.169.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.169.0"
  }
}
